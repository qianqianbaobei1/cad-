    "design_principles": [
      "决策类型: REQUIRED(必须出现)/CONDITIONAL(条件触发)/OPTIONAL(默认不输出)/FORBIDDEN(条件触发时禁止)/EXCLUDED(永远不应出现)",
      "辅材分级: S1(必要辅材-默认输出)/S2(条件辅材-条件输出)/S3(零星辅材-默认不输出)",
      "FORBIDDEN规则保护编码-名称一致性，防止错误材料推荐",
      "condition为空=无条件触发，condition不为空=评估条件后决定"
    ],
    "rule_types": {
      "REQUIRED": "必须包含，缺失=block",
      "CONDITIONAL": "条件满足时包含，不满足时排除",
      "OPTIONAL": "可选用，默认不输出但可供用户选择",
      "FORBIDDEN": "命中condition时禁止出现，出现=block",
      "EXCLUDED": "该编码永远不应出现此材料"
    },
    "aux_grades": {
      "S1": "必要辅材 — 缺失会导致质量问题或被监理强制要求补上",
      "S2": "条件辅材 — 一般工程惯例包含，可条件输出",
      "S3": "零星辅材 — 有替代方案，默认不输出"
    }
  },
