        "壁挂",
        "挂墙",
        "嵌墙",
        "明装",
        "暗装",
        "距地",
        "抬高",
        "柱上"
      ],
      "quantity_regex": "共\\s*(\\d+)\\s*台",
      "caption_name_marks": [
        "系统图",
        "配电箱",
        "配电柜",
        "总箱",
        "控制箱",
        "控制柜",
        "电源箱",
        "变频柜",
        "动力柜",
        "照明箱",
        "开关箱",
        "箱",
        "柜",
        "屏"
      ],
      "feed_marks": [
        "引来",
        "引自",
        "来自"
      ],
      "spare_marks": [
        "备用",
        "预留",
        "消防备用"
      ],
      "meter_marks": [
        "多功能表",
        "多功能仪表",
        "电能表",
        "电度表",
        "电流表",
        "电压表"
      ],
      "ats_marks": [
