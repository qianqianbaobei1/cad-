    "OVERVIEW_LONG_EDGE": "render.overview_long_edge",
    "MIN_LINE_WIDTH_PX": "render.min_line_width_px",
    "TILE_TRIGGER_MM": "render.tile_trigger_mm",
    "TILE_DENSE_DRAWINGS": "render.tile_dense_drawings",
    "TILE_DENSE_ITEMS": "render.tile_dense_items",
    "TILE_OVERLAP": "render.tile_overlap",
    "TILE_TARGET_LONG_MM": "render.tile_target_long_mm",
    "TILE_MAX_COLS": "render.tile_max_cols",
    "TILE_MAX_ROWS": "render.tile_max_rows",
    "MAX_TEXT_ENTITIES_LIMIT": "cad.max_text_entities_limit",
    "CAD_BREAKER_FILL_RATE_MIN": "gates.cad_breaker_fill_rate_min",
    "CAD_MIN_BREAKERS_ABSOLUTE": "gates.cad_min_breakers_absolute",
    "TILE_TARGET_LONG_MM_DENSE": "render.tile_target_long_mm_dense"
  },
  "render": {
