        "后备保护器"
      ],
      "spd_detail_regex": "(?:Up\\s*[≤<]|Iimp|Imax|In\\s*=\\s*\\d+(?:\\.\\d+)?\\s*kA|SPD|T[12]级|[ⅠⅡI]+级|电涌|浪涌)",
      "ct_ratio_regex": "^\\d{1,5}/[15]A?$",
      "incoming_ct_count": 3,
      "skip_text_regex": "^(?:Pe|Pjs|Ijs|Kx|cos\\s*φ|Cosφ|Ijs|P\\s*e)\\s*[=＝]",
      "breaker_rating_regex": "\\d+\\s*A(?![A-Za-z])|(?<![A-Za-z0-9])[BCDK]\\s?\\d{1,3}(?!\\d)|\\d+[xX×]\\d+A",
      "incoming_under_heights": 12,
      "neighbor_margin_heights": 4,
      "install_above_heights": 5,
      "caption_code_reject_regexes": [
