  "gates": {
    "_comment": "原生 CAD 提取结果进入流水线的准入条件；不达标即回退视觉大模型。",
    "cad_breaker_fill_rate_min": 0.5,
    "cad_min_breakers_absolute": 20,
    "cad_min_boxes": 1,
    "cad_min_circuits": 1
  },
  "evidence": {
    "_comment": "证据来源权重。物理事实字段只接受独立于模型自述的证据（CAD 原生矢量文字 / PDF 内嵌文字层 / OCR / 人工），模型自述只能到 PARSED_OK。",
    "physical_fact_origins": [
      "cad_native",
      "pdf_text",
      "ocr",
      "human"
    ],
    "model_origin": "model_vision",
    "allow_confirmed_without_physical": false
  },
  "takeoff": {
    "_comment": "原生读图引擎（sheets.py / takeoff.py）。长度阈值一律以全图文字字高中位数为单位，不写死图纸单位。",
    "sheets": {
      "min_side_text_heights": 40,
      "max_aspect": 4.5,
      "edge_tol_text_heights": 0.5,
      "border_merge_ratio": 0.03,
      "crossing_allowance_ratio": 0.002,
      "title_block_x_ratio": 0.55,
      "title_block_y_ratio": 0.35,
      "note_title_markers": [
        "说明",
        "目录",
        "材料表",
        "图例",
        "设备表"
      ],
      "unnumbered_overlap_drop": 0.1,
      "variant_content_tolerance": 0.15,
      "catalog_min_rows": 3,
      "catalog_row_gap_text_heights": 5,
      "system_min_breakers": 3
    },
    "diagram": {
      "_comment": "系统图回路解析（takeoff.py）。距离一律以字高为单位；词表按设计院写法补充即可，不改代码。",
      "column_tol_heights": 4.5,
      "box_gap_factor": 2.4,
      "header_above_heights": 8,
      "header_left_heights": 40,
      "header_right_heights": 45,
      "row_reach_heights": 90,
      "incoming_left_heights": 40,
      "incoming_below_heights": 20,
      "incoming_above_heights": 4,
      "caption_left_heights": 35,
      "caption_right_heights": 60,
      "caption_max_gap_heights": 40,
      "cabinet_type_regex": "^(?:GGD|GCK|GCS|MNS|XL-?\\d*|XRM|XXM|XGM|XMR|JXF|PZ-?\\d+|ACM|XDD|XRC|XMD|XLW)\\b",
      "ip_regex": "IP\\s*[0-9X]{2}",
      "install_marks": [
