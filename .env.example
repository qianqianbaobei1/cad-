# 复制为 .env 并填写
VISION_API_KEY=
# OpenAI 兼容接口地址,按需修改
VISION_BASE_URL=https://api.openai.com/v1
# 视觉模型名称,需支持图像输入
VISION_MODEL=gpt-4o

# ---- 可选的助手问答配置(不填则复用上面的 VISION_*) ----
# ASSISTANT_API_KEY=
# ASSISTANT_BASE_URL=
# ASSISTANT_MODEL=

# 识图温度,建议 0
# VISION_TEMPERATURE=0
# 随机种子。DeepSeek 未将 seed 列为支持参数,该接口不会发送
# VISION_SEED=42

# ---- 推荐配置:阿里云百炼 Qwen-VL-Max(国内直连,中文图纸识别强) ----
# VISION_API_KEY=sk-你的百炼key
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_MODEL=qwen-vl-max

# ---- 备选:智谱 bigmodel(国内直连,有免费档) ----
# VISION_API_KEY=你的智谱key
# VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# VISION_MODEL=glm-4.6v

# ---- 账号 ----
# 首次启动时创建的管理员 admin 的密码；不填则随机生成并在控制台打印一次
# ADMIN_INITIAL_PASSWORD=
# 公开部署请设为 production（未登录请求不会落到默认租户）
# ENV=production
